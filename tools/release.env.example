# Copy to tools/release.env — that path is gitignored, so nothing here reaches
# the repository. Environment variables take precedence over this file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Docker Hub namespace the images are pushed to. Set this to your own account or
# organisation — the release script refuses to run without it, so nobody can
# accidentally push to someone else's namespace.
PLANE_REGISTRY_NS=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Suffix identifying this fork in the tag: v<upstream version>-<suffix>.<n>
# PLANE_FORK_SUFFIX=lonestone

# ---------------------------------------------------------------------------
# Build-time frontend configuration
# ---------------------------------------------------------------------------
#
# These are compiled INTO the JS bundle of web / admin / space, so they cannot
# be changed after the build. Leaving them empty produces relative paths, which
# is correct when everything is served behind one proxy on a single origin.
#
# Only set them if the apps live on separate domains or under a different
# sub-path. In that case, retagging an existing image is NOT enough — the image
# must be rebuilt with the correct values.
#
# Anything here ships to every visitor in plain text. Never put a secret in a
# VITE_* variable.

# VITE_API_BASE_URL=
# VITE_API_BASE_PATH=/api

# VITE_WEB_BASE_URL=
# VITE_WEB_BASE_PATH=

# VITE_ADMIN_BASE_URL=
# VITE_ADMIN_BASE_PATH=/god-mode

# VITE_SPACE_BASE_URL=
# VITE_SPACE_BASE_PATH=/spaces

# VITE_LIVE_BASE_URL=
# VITE_LIVE_BASE_PATH=/live
