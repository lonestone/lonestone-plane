# Copy to tools/release.env to override variables that are frozen at build time.
#
# These values are compiled INTO the JS bundle of web / admin / space.
# Leaving them empty produces relative paths, which works when everything is
# served behind the same proxy on a single origin.
#
# Only fill these in if you deploy the apps on separate domains or under a
# different sub-path. In that case, retagging an existing image is NOT enough:
# you must rebuild with the correct values.

VITE_API_BASE_URL=
VITE_API_BASE_PATH=/api

VITE_WEB_BASE_URL=
VITE_WEB_BASE_PATH=

VITE_ADMIN_BASE_URL=
VITE_ADMIN_BASE_PATH=/god-mode

VITE_SPACE_BASE_URL=
VITE_SPACE_BASE_PATH=/spaces

VITE_LIVE_BASE_URL=
VITE_LIVE_BASE_PATH=/live
